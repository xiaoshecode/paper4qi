# Variable names only. The Python service does NOT auto-load this file.
# Public frontend build setting: HTTPS backend origin and optional path prefix.
# Empty retains same-origin Sites/local behavior; never put a secret here.
PUBLIC_API_BASE_URL=
# Export a newly generated key in the server process environment or use your
# deployment platform's secret manager. Never put credentials in PUBLIC_* vars.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Standalone server: keep an invalid/unverified model credential disabled.
PAPER4QI_AI_ENABLED=1
# Local: requests per server session. Online: persistent requests per UTC day.
# Includes cache hits and failed requests; this is not a currency budget.
PAPER4QI_MAX_AI_REQUESTS=20
# Online only: authorized Sites user IDs, comma-separated. Empty denies writes.
# This value is a server runtime secret; do not put it in PUBLIC_* variables.
PAPER4QI_EDITOR_IDS=
# Optional bootstrap allowlist from Sites-authenticated email headers.
# Keep the actual allowlist private in the hosting environment.
PAPER4QI_EDITOR_EMAILS=
# Standalone backend settings. These are server-only, never PUBLIC_* values.
PAPER4QI_PUBLIC_ORIGIN=
PAPER4QI_FRONTEND_ORIGIN=
PAPER4QI_OWNER_PASSWORD_HASH=
# SQLite stays on the Alibaba host. Never point it at a cloud sync mount.
PAPER4QI_DB_PATH=/var/lib/paper4qi/library.sqlite
# Storage checks only: leave local until a dedicated paper4qi library is verified.
PAPER4QI_STORAGE_BACKEND=local
PAPER4QI_LOCAL_STORAGE_ROOT=/var/lib/paper4qi/objects
SEAFILE_BASE_URL=
SEAFILE_LIBRARY_ID=
SEAFILE_REPO_TOKEN=
# Read-only directory to inspect in the dedicated paper4qi library.
SEAFILE_DIRECTORY=/paper4qi
