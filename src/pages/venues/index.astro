---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  JOURNALS, CONFS, CONF_DEADLINES, FIELD_ZH, FIELD_EN, CCF_CHANGES, TYPE_TARGETS,
  TIERS, STRATEGY, VENUE_COUNTS,
} from '../../data/venues';
import type { VenueField, ConfDeadline } from '../../data/venues';

const base = import.meta.env.BASE_URL;

// 7 个领域：顺序即页面小节顺序
const FIELD_ORDER: VenueField[] = ['quantum', 'arch', 'eda', 'cir', 'se', 'net', 'top'];
// 色标复用 global.css 已有变量（亮/暗双主题均已校准）
const FIELD_COLOR: Record<VenueField, string> = {
  quantum: 'var(--c-QML)', arch: 'var(--c-ARCH)', eda: 'var(--c-MAT)', cir: 'var(--c-CRYO)',
  se: 'var(--c-ALG)', net: 'var(--c-COMM)', top: 'var(--c-REV)',
};
const TIER_ORDER = ['T1', 'T2', 'T3', 'T4'] as const;
const TIER_LABEL: Record<string, string> = { T1: '第一梯队', T2: '第二梯队', T3: '第三梯队', T4: '第四梯队' };
const TIER_LABEL_EN: Record<string, string> = { T1: 'Tier 1', T2: 'Tier 2', T3: 'Tier 3', T4: 'Tier 4' };

const fieldTotals = Object.fromEntries(
  FIELD_ORDER.map((f) => [f, {
    journals: JOURNALS.filter((j) => j.field === f).length,
    confs: CONFS.filter((c) => c.field === f).length,
    total: JOURNALS.filter((j) => j.field === f).length + CONFS.filter((c) => c.field === f).length,
  }]),
) as Record<VenueField, { journals: number; confs: number; total: number }>;

const grandTotal = VENUE_COUNTS.journals + VENUE_COUNTS.confs;

// 每个领域的小节：期刊分组（量子专业按梯队再分，末尾为不标梯队的 APS/应用物理系）+ 会议
interface JGroup { zh: string; en: string; items: typeof JOURNALS; }
const sections = FIELD_ORDER.map((f) => {
  const js = JOURNALS.filter((j) => j.field === f);
  let groups: JGroup[];
  if (f === 'quantum') {
    groups = TIER_ORDER
      .map((t) => ({ zh: TIER_LABEL[t], en: TIER_LABEL_EN[t], items: js.filter((j) => j.tier === t) }))
      .filter((g) => g.items.length > 0);
    const untiered = js.filter((j) => !j.tier);
    if (untiered.length > 0) groups.push({ zh: '相关 APS / 应用物理期刊', en: 'Related APS / applied-physics journals', items: untiered });
  } else {
    groups = [{ zh: '期刊', en: 'Journals', items: js }];
  }
  return { field: f, groups, confs: CONFS.filter((c) => c.field === f) };
});

// CFP 截止日期：按最早截止日排序；数组为空时页面显示占位提示
type Kind = 'abs' | 'full' | 'notif';
const matchPhase = (s: string, kind: Kind): boolean => {
  const t = s.toLowerCase();
  if (kind === 'abs') return t.includes('abstract') || s.includes('摘要');
  if (kind === 'full') return t.includes('full') || t.includes('paper') || s.includes('全文') || s.includes('投稿');
  return t.includes('notif') || t.includes('accept') || s.includes('通知') || s.includes('录用');
};
const findPhase = (d: ConfDeadline, kind: Kind) =>
  d.deadlines.find((x) => matchPhase(x.phase, kind) || matchPhase(x.phaseEn, kind));
const asTime = (s?: string): number | null => {
  if (!s) return null;
  const n = Date.parse(s);
  return Number.isNaN(n) ? null : n;
};

const deadlineRows = CONF_DEADLINES.map((d) => {
  const abs = findPhase(d, 'abs');
  const full = findPhase(d, 'full');
  const notif = findPhase(d, 'notif');
  const used = new Set([abs, full, notif].filter(Boolean));
  const others = d.deadlines.filter((x) => !used.has(x));
  const keys = [asTime(abs?.date), asTime(full?.date), asTime(notif?.date)].filter((n): n is number => n !== null);
  return { d, abs, full, notif, others, sortKey: keys.length ? Math.min(...keys) : Number.MAX_SAFE_INTEGER };
}).sort((a, b) => {
  // 开放投稿的在前（最早截止优先，最紧迫的可投会议排最上）；已截止的在后（最近截止优先），作周期参考
  const ao = a.d.status !== 'closed';
  const bo = b.d.status !== 'closed';
  if (ao !== bo) return ao ? -1 : 1;
  return ao ? a.sortKey - b.sortKey : b.sortKey - a.sortKey;
});

const SCOPE_ROWS = [
  { k: '影响因子 IF', kEn: 'Impact factor (IF)', v: '2025 JCR（2026 年 6 月发布，LetPub 已同步）', vEn: '2025 JCR (released June 2026, synced on LetPub)' },
  { k: '中科院分区', kEn: 'CAS partition', v: '2025 年 3 月升级版（大类 / 小类 / Top）', vEn: 'March 2025 upgraded edition (major / minor / Top)' },
  { k: 'CCF 分级', kEn: 'CCF ranking', v: '第七版目录（2026），2026-03-31 正式发布', vEn: '7th edition (2026), released 2026-03-31' },
  { k: '审稿周期 / APC', kEn: 'Review time / APC', v: 'LetPub 详情页（网友经验或期刊官网数据，标注口径）', vEn: 'LetPub journal pages (user reports or publisher data; the basis is stated)' },
  { k: '会议接收率', kEn: 'Conference acceptance rate', v: '历史公开数据 / 社区统计的约值，未找到官方数字的均标注「约」', vEn: 'Approximate values from historical public data / community statistics; marked “~” where no official figure exists' },
];
---

<BaseLayout title="期刊与会议投稿指南" description="量子计算方向的期刊与会议名录：49 本期刊与 27 个会议的 IF（2025 JCR）、中科院分区、CCF 2026 第七版分级、OA/APC、审稿周期、声誉梯队与 CFP 截止日期，2026-10-08 联网核验。">
  <div class="wrap page-head">
    <div class="kicker"><span class="i18n-zh">投稿指南 · 2026-10-08 联网核验</span><span class="i18n-en">Guide · verified 2026-10-08</span></div>
    <h1><span class="i18n-zh">期刊与会议名录</span><span class="i18n-en">Journals &amp; Conferences</span></h1>
    <p class="lede">
      <span class="i18n-zh">量子测控与量子计算方向的投稿目标速查：{VENUE_COUNTS.journals} 本期刊 + {VENUE_COUNTS.confs} 个会议，覆盖量子专业、体系结构、EDA、电路与测控、软件工程、网络、综合顶刊 7 个领域，含 2025 JCR 影响因子、中科院 2025 分区、CCF 2026 第七版分级、OA/APC 与审稿周期。逐项数据核验于 2026-10-08。</span>
      <span class="i18n-en">A quick reference for submission targets in quantum control and quantum computing: {VENUE_COUNTS.journals} journals and {VENUE_COUNTS.confs} conferences across seven fields — quantum, architecture, EDA, circuits &amp; instrumentation, software engineering, networking and general science — with 2025 JCR impact factors, the 2025 CAS partition, the 7th edition (2026) CCF ranking, OA/APC and review times. Every entry was verified on 2026-10-08.</span>
    </p>
  </div>

  <div class="wrap page-body">

    <!-- 数据口径 -->
    <div class="card vcard">
      <h2 class="vcard-title"><span class="i18n-zh">数据口径</span><span class="i18n-en">Data Conventions</span></h2>
      <table class="vtable">
        <thead><tr>
          <th style="width:20%"><span class="i18n-zh">数据项</span><span class="i18n-en">Item</span></th>
          <th><span class="i18n-zh">口径</span><span class="i18n-en">Convention</span></th>
        </tr></thead>
        <tbody>
          {SCOPE_ROWS.map((r) => (
            <tr>
              <td><b><span class="i18n-zh">{r.k}</span><span class="i18n-en">{r.kEn}</span></b></td>
              <td><span class="i18n-zh">{r.v}</span><span class="i18n-en">{r.vEn}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="vwarn">
        <p><b><span class="i18n-zh">口径提示 1</span><span class="i18n-en">Note 1</span></b><span class="i18n-zh">：LetPub 搜索结果列表中的「综合评分」（如 QST 显示 7.1）不是 IF，是 LetPub 自创评分；官方 IF 一律以详情页为准（QST = 5.0，与 IOP 官网 4.9 属 2025 vs 2024 JCR 版本差异）。</span><span class="i18n-en">: The “overall score” in LetPub search results (e.g. 7.1 for QST) is not an IF but LetPub’s own rating; official IFs are taken from the journal pages (QST = 5.0, versus 4.9 on the IOP site — a 2025-vs-2024 JCR version difference).</span></p>
        <p><b><span class="i18n-zh">口径提示 2</span><span class="i18n-en">Note 2</span></b><span class="i18n-zh">：CCF 官网分类页截至查询日仍挂 2022 旧版（无 TQC、HPDC 在 B、ISCAS 在 C）。本页以 CCF 官网新闻（2026-03-31 发布第七版）+ atom.im 2026 数据 + 社区转录 PDF 三源交叉验证为准。</span><span class="i18n-en">: As of the verification date the CCF website still displayed the 2022 edition (no TQC; HPDC under B; ISCAS under C). This page follows the cross-checked 2026 data: the CCF news release (7th edition, 2026-03-31), the 2026 data on atom.im, and a community-transcribed PDF.</span></p>
      </div>
    </div>

    <!-- CCF 2026 变化 -->
    <div class="card vcard">
      <h2 class="vcard-title"><span class="i18n-zh">CCF 2026 目录变化（第七版，2026-03-31 发布）</span><span class="i18n-en">CCF 2026 Catalogue Changes (7th edition, released 2026-03-31)</span></h2>
      <p class="vhint"><span class="i18n-zh">相对 2022 旧版的升降与修正；<b>不在此列表</b>表示分级未变。</span><span class="i18n-en">Promotions, demotions and corrections relative to the 2022 edition; entries <b>not listed</b> kept their rank.</span></p>
      <table class="vtable">
        <thead><tr>
          <th style="width:16%"><span class="i18n-zh">名称</span><span class="i18n-en">Name</span></th>
          <th style="width:22%"><span class="i18n-zh">旧 → 新（2022 → 2026）</span><span class="i18n-en">Old → New (2022 → 2026)</span></th>
          <th><span class="i18n-zh">说明</span><span class="i18n-en">Note</span></th>
        </tr></thead>
        <tbody>
          {CCF_CHANGES.map((c) => (
            <tr>
              <td><b>{c.name}</b>{c.name === 'ISCAS' && <span class="chg-badge star" title="ISCAS 2027 目标会议">★</span>}</td>
              <td class="mono chg-cell">
                <span class="chg-old">{c.old}</span>
                <span class="chg-arrow">→</span>
                <span class="chg-new">{c.new}</span>
                {c.up === true && <span class="chg-badge up">↑</span>}
                {c.up === false && <span class="chg-badge down">↓</span>}
                {c.up === null && <span class="chg-badge nul">修正</span>}
              </td>
              <td><span class="i18n-zh">{c.note}</span><span class="i18n-en">{c.noteEn}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 会议 CFP 截止日期 -->
    <div class="card vcard">
      <h2 class="vcard-title"><span class="i18n-zh">会议 CFP 截止日期</span><span class="i18n-en">Conference CFP Deadlines</span></h2>
      {deadlineRows.length === 0 ? (
        <div class="vempty">
          <span class="i18n-zh">CFP 截止日期整理中（数据核验中，即将上线）</span>
          <span class="i18n-en">Deadline data coming soon</span>
        </div>
      ) : (
        <>
          <p class="vhint"><span class="i18n-zh">开放投稿的会议在前（按最早截止日），已截止的列在其后（最近截止优先）供周期参考；标注「推断」的为官网未公布、按上届周期推算的日期；时区以各会议官网为准。</span><span class="i18n-en">Conferences still open for submission come first (by earliest deadline), followed by closed ones (most recently closed first) as cycle references. Entries marked “projected” are estimated from the previous edition until the official site publishes dates. Time zones follow each conference’s site.</span></p>
          <table class="vtable">
            <thead><tr>
              <th><span class="i18n-zh">会议</span><span class="i18n-en">Conference</span></th>
              <th><span class="i18n-zh">摘要截止</span><span class="i18n-en">Abstract</span></th>
              <th><span class="i18n-zh">全文截止</span><span class="i18n-en">Full paper</span></th>
              <th><span class="i18n-zh">录用通知</span><span class="i18n-en">Notification</span></th>
              <th><span class="i18n-zh">会议日期 · 地点</span><span class="i18n-en">Dates · Location</span></th>
              <th><span class="i18n-zh">CFP</span><span class="i18n-en">CFP</span></th>
            </tr></thead>
            <tbody>
              {deadlineRows.map((r) => (
                <tr>
                  <td>
                    <b>{r.d.edition}</b>
                    {r.d.status && (
                      <span class={`dl-badge ${r.d.status === 'closed' ? 'dl-closed' : 'dl-open'}`}>
                        <span class="i18n-zh">{r.d.status === 'closed' ? '已截止' : '开放投稿'}</span>
                        <span class="i18n-en">{r.d.status === 'closed' ? 'Closed' : 'Open'}</span>
                      </span>
                    )}
                    {(r.d.note || r.d.noteEn) && (
                      <div class="vsub">
                        <span class="i18n-zh">{r.d.note}</span>
                        <span class="i18n-en">{r.d.noteEn}</span>
                      </div>
                    )}
                    {r.others.length > 0 && (
                      <div class="vsub">
                        {r.others.map((o) => (
                          <span class="i18n-zh">{o.phase}：{o.date}{o.note ? `（${o.note}）` : ''}</span>
                        ))}
                        {r.others.map((o) => (
                          <span class="i18n-en">{o.phaseEn}: {o.date}{o.note ? ` (${o.note})` : ''}</span>
                        ))}
                      </div>
                    )}
                  </td>
                  <td class="mono">{r.abs ? r.abs.date : '—'}</td>
                  <td class="mono">{r.full ? r.full.date : '—'}</td>
                  <td class="mono">{r.notif ? r.notif.date : '—'}</td>
                  <td class="mono">
                    <span class="i18n-zh">{[r.d.confDate, r.d.location].filter(Boolean).join(' · ') || '—'}</span>
                    <span class="i18n-en">{[r.d.confDate, r.d.locationEn ?? r.d.location].filter(Boolean).join(' · ') || '—'}</span>
                  </td>
                  <td>{r.d.link ? <a href={r.d.link} target="_blank" rel="noopener">CFP ↗</a> : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}
    </div>

    <!-- 按论文类型选投稿目标 -->
    <div class="card vcard">
      <h2 class="vcard-title"><span class="i18n-zh">按论文类型选投稿目标</span><span class="i18n-en">Choosing a Target by Paper Type</span></h2>
      <table class="vtable">
        <thead><tr>
          <th style="width:30%"><span class="i18n-zh">论文类型</span><span class="i18n-en">Paper type</span></th>
          <th style="width:35%"><span class="i18n-zh">首选</span><span class="i18n-en">First choice</span></th>
          <th><span class="i18n-zh">次选</span><span class="i18n-en">Second choice</span></th>
        </tr></thead>
        <tbody>
          {TYPE_TARGETS.map((t) => (
            <tr>
              <td><span class="i18n-zh"><b>{t.type}</b></span><span class="i18n-en"><b>{t.typeEn}</b></span></td>
              <td class="mono">{t.first}</td>
              <td class="mono vsecond">{t.second}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 期刊与会议名录 -->
    <div class="card vcard">
      <div class="vcard-head">
        <h2 class="vcard-title" style="margin:0"><span class="i18n-zh">{VENUE_COUNTS.journals} 本期刊 + {VENUE_COUNTS.confs} 个会议</span><span class="i18n-en">{VENUE_COUNTS.journals} Journals + {VENUE_COUNTS.confs} Conferences</span></h2>
        <div class="chip-row" id="venues-filter">
          <button class="chip on" data-f="all"><span class="i18n-zh">全部</span><span class="i18n-en">All</span> <span class="cnt">{grandTotal}</span></button>
          {FIELD_ORDER.map((f) => (
            <button class="chip" data-f={f}>
              <span class="dot" style={`background:${FIELD_COLOR[f]}`}></span>
              <span class="i18n-zh">{FIELD_ZH[f]}</span><span class="i18n-en">{FIELD_EN[f]}</span>
              <span class="cnt">{fieldTotals[f].total}</span>
            </button>
          ))}
        </div>
      </div>

      {sections.map((s) => (
        <section class="vfield" data-field={s.field}>
          <h3 class="vfield-title">
            <span class="vdot" style={`background:${FIELD_COLOR[s.field]}`}></span>
            <span class="i18n-zh">{FIELD_ZH[s.field]}（{fieldTotals[s.field].journals} 刊 · {fieldTotals[s.field].confs} 会）</span>
            <span class="i18n-en">{FIELD_EN[s.field]} ({fieldTotals[s.field].journals} journals · {fieldTotals[s.field].confs} conferences)</span>
          </h3>

          {s.groups.map((g) => (
            <div class="vgroup">
              <h4 class="vgroup-title"><span class="i18n-zh">{g.zh}</span><span class="i18n-en">{g.en}</span></h4>
              <table class="vtable">
                <thead><tr>
                  <th style="width:24%"><span class="i18n-zh">期刊</span><span class="i18n-en">Journal</span></th>
                  <th style="width:8%">IF</th>
                  <th style="width:15%"><span class="i18n-zh">分区</span><span class="i18n-en">CAS</span></th>
                  <th style="width:7%">CCF</th>
                  <th style="width:15%">OA · APC</th>
                  <th style="width:10%"><span class="i18n-zh">审稿</span><span class="i18n-en">Review</span></th>
                  <th><span class="i18n-zh">备注</span><span class="i18n-en">Note</span></th>
                </tr></thead>
                <tbody>
                  {g.items.map((j) => (
                    <tr>
                      <td>
                        {j.link
                          ? <a href={j.link} target="_blank" rel="noopener"><b>{j.name}</b></a>
                          : <b>{j.name}</b>}
                        <div class="vsub mono">{j.org}</div>
                      </td>
                      <td class="mono">
                        {j.if !== undefined ? j.if.toFixed(1) : '—'}
                        {j.ifNote && <div class="vsub">{j.ifNote}</div>}
                      </td>
                      <td>{j.cas}</td>
                      <td>
                        {j.ccf === undefined && <span class="faint">—</span>}
                        {j.ccf === 'none' && <span class="ccf-badge none"><span class="i18n-zh">未收录</span><span class="i18n-en">n/a</span></span>}
                        {(j.ccf === 'A' || j.ccf === 'B' || j.ccf === 'C') && <span class={`ccf-badge ${j.ccf.toLowerCase()}`}>{j.ccf}</span>}
                      </td>
                      <td class="mono">{j.apc ? `${j.oa} · ${j.apc}` : j.oa}</td>
                      <td>{j.review ?? '—'}</td>
                      <td><span class="i18n-zh">{j.note}</span><span class="i18n-en">{j.noteEn}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}

          {s.confs.length > 0 && (
            <div class="vgroup">
              <h4 class="vgroup-title"><span class="i18n-zh">会议</span><span class="i18n-en">Conferences</span></h4>
              <table class="vtable">
                <thead><tr>
                  <th style="width:26%"><span class="i18n-zh">会议</span><span class="i18n-en">Conference</span></th>
                  <th style="width:9%">CCF</th>
                  <th style="width:14%"><span class="i18n-zh">接收率（约）</span><span class="i18n-en">Acceptance (~)</span></th>
                  <th><span class="i18n-zh">备注</span><span class="i18n-en">Note</span></th>
                </tr></thead>
                <tbody>
                  {s.confs.map((c) => (
                    <tr>
                      <td><b>{c.name}</b></td>
                      <td>
                        {c.ccf === undefined && <span class="faint">—</span>}
                        {c.ccf === 'none' && <span class="ccf-badge none"><span class="i18n-zh">未收录</span><span class="i18n-en">n/a</span></span>}
                        {(c.ccf === 'A' || c.ccf === 'B' || c.ccf === 'C') && <span class={`ccf-badge ${c.ccf.toLowerCase()}`}>{c.ccf}</span>}
                      </td>
                      <td class="mono">{c.rate ?? '—'}</td>
                      <td><span class="i18n-zh">{c.note}</span><span class="i18n-en">{c.noteEn}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- 声誉梯队 -->
    <div class="card vcard">
      <h2 class="vcard-title"><span class="i18n-zh">声誉梯队总表</span><span class="i18n-en">Reputation Tiers</span></h2>
      <p class="vhint"><span class="i18n-zh">综合 IF / 分区 / CCF 与社区声誉的排序，仅用于定位投稿层次，不代表任何官方评价。</span><span class="i18n-en">An ordering combining IF, partition, CCF rank and community reputation, meant only to locate submission tiers — not an official rating.</span></p>
      <div class="vtiers">
        {TIERS.map((t) => (
          <div class="vtier">
            <div class="vtier-title"><span class="i18n-zh">{t.title}</span><span class="i18n-en">{t.titleEn}</span></div>
            <pre class="vtier-pre mono">{t.lines.join('\n')}</pre>
          </div>
        ))}
      </div>
    </div>

    <!-- 投稿策略速查 -->
    <div class="card vcard">
      <h2 class="vcard-title"><span class="i18n-zh">投稿策略速查</span><span class="i18n-en">Submission Strategy at a Glance</span></h2>
      <div class="vstrategy">
        {STRATEGY.map((s, i) => (
          <div class="vstrat">
            <div class="vstrat-title"><span class="vstrat-no mono">{i + 1}</span><span class="i18n-zh">{s.title}</span><span class="i18n-en">{s.titleEn}</span></div>
            <div class="vstrat-body"><span class="i18n-zh">{s.body}</span><span class="i18n-en">{s.bodyEn}</span></div>
          </div>
        ))}
      </div>
    </div>

    <p class="vfoot">
      <span class="i18n-zh">数据核验于 2026-10-08；IF / 分区 / CCF 与会议信息以各期刊、会议官网最新公布为准。本板块为手工策展，不在每周自动更新范围内；「开放投稿 / 已截止」徽章为核验日快照，不随时间自动推移。</span>
      <span class="i18n-en">Verified 2026-10-08; IFs, partitions, CCF ranks and conference details follow the latest figures published by the respective journals and conference sites. This section is manually curated and is not part of the weekly automated update; the open/closed badges are snapshots as of the verification date and do not roll forward automatically.</span>
    </p>

  </div>
</BaseLayout>

<style>
  /* 投稿指南板块局部样式（不动 global.css，全部走 CSS 变量） */
  .vcard { padding: 20px 24px; margin-bottom: 18px; }
  .vcard-title { margin: 0 0 12px; font-size: 17px; font-weight: 700; }
  .vcard-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 6px; }
  .vhint { margin: 0 0 12px; font-size: 12.5px; color: var(--faint); }
  .vsub { font-size: 11px; color: var(--faint); line-height: 1.6; }
  .faint { color: var(--faint); }

  .vtable { border-collapse: collapse; width: 100%; font-size: 12.5px; }
  .vtable th, .vtable td { border-bottom: 1px solid var(--line); padding: 7px 10px; text-align: left; vertical-align: top; line-height: 1.65; }
  .vtable thead th { background: var(--line2); border-bottom: 1px solid var(--line); font-weight: 650; color: var(--ink); font-size: 12px; white-space: nowrap; }
  .vtable tbody tr:hover { background: var(--line2); }
  .vsecond { color: var(--muted); }

  .vwarn { margin-top: 12px; border-left: 2px solid var(--gold); background: var(--line2); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 9px 13px; }
  .vwarn p { margin: 0 0 6px; font-size: 12.5px; color: var(--muted); line-height: 1.75; }
  .vwarn p:last-child { margin-bottom: 0; }
  .vwarn b { color: var(--gold); }

  .vempty { text-align: center; padding: 30px 16px; color: var(--faint); font-size: 13px; border: 1px dashed var(--line); border-radius: var(--radius-sm); }

  /* CCF 2026 变化：old → new 与升降徽章 */
  .chg-cell { white-space: nowrap; }
  .chg-old { color: var(--faint); }
  .chg-arrow { color: var(--faint); margin: 0 5px; }
  .chg-new { color: var(--ink); font-weight: 650; }
  .chg-badge { display: inline-block; margin-left: 6px; font-size: 10px; font-weight: 700; border-radius: 6px; padding: 1px 6px; line-height: 1.5; vertical-align: 1px; }
  .chg-badge.up { color: color-mix(in srgb, var(--c-SENS) 68%, var(--ink)); background: color-mix(in srgb, var(--c-SENS) 16%, transparent); }
  .chg-badge.down { color: color-mix(in srgb, var(--c-QEC) 70%, var(--ink)); background: color-mix(in srgb, var(--c-QEC) 14%, transparent); }
  .chg-badge.nul { color: var(--muted); background: var(--line2); border: 1px solid var(--line); font-weight: 600; }
  .chg-badge.star { color: var(--gold); background: var(--gold-soft); }

  /* CCF 分级徽章 */
  .ccf-badge { display: inline-block; font-size: 10.5px; font-weight: 700; border-radius: 6px; padding: 1px 7px; line-height: 1.6; }
  .ccf-badge.a { color: var(--accent-ink); background: var(--accent-soft); border: 1px solid var(--accent-line); }
  .ccf-badge.b { color: var(--gold); background: var(--gold-soft); border: 1px solid color-mix(in srgb, var(--gold) 38%, transparent); }
  .ccf-badge.c { color: var(--muted); background: var(--line2); border: 1px solid var(--line); }
  .ccf-badge.none { color: var(--faint); background: transparent; border: 1px dashed var(--line); font-weight: 500; }

  /* CFP 截止状态徽章 */
  .dl-badge { display: inline-block; margin-left: 7px; font-size: 10px; font-weight: 700; border-radius: 6px; padding: 1px 6px; line-height: 1.5; vertical-align: 1px; }
  .dl-badge.dl-open { color: var(--accent-ink); background: var(--accent-soft); border: 1px solid var(--accent-line); }
  .dl-badge.dl-closed { color: var(--muted); background: var(--line2); border: 1px solid var(--line); font-weight: 600; }

  /* 领域小节 */
  .vfield { margin-top: 22px; }
  .vfield-title { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 15px; font-weight: 700; letter-spacing: -.01em; }
  .vfield:first-of-type .vfield-title { border-top: 0; padding-top: 0; }
  .vdot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .vgroup { margin-bottom: 16px; }
  .vgroup-title { margin: 0 0 6px; font-size: 12.5px; font-weight: 650; color: var(--muted); letter-spacing: .02em; }
  .vfield.hidden-by-filter { display: none; }

  /* 声誉梯队：等宽代码块风格 */
  .vtiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
  .vtier { border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--line2); padding: 12px 14px; }
  .vtier-title { font-weight: 680; font-size: 13px; margin-bottom: 7px; }
  .vtier-pre { margin: 0; font-size: 11.5px; line-height: 1.8; color: var(--muted); white-space: pre-wrap; overflow-wrap: anywhere; }

  /* 投稿策略 */
  .vstrategy { display: flex; flex-direction: column; gap: 12px; }
  .vstrat { border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--line2); padding: 12px 15px; }
  .vstrat-title { display: flex; align-items: baseline; gap: 8px; font-weight: 680; font-size: 13.5px; margin-bottom: 5px; }
  .vstrat-no { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 19px; height: 19px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-ink); font-size: 11px; font-weight: 700; }
  .vstrat-body { font-size: 12.5px; color: var(--muted); line-height: 1.8; }

  .vfoot { margin: 6px 2px 0; font-size: 12px; color: var(--faint); line-height: 1.8; }

  @media (max-width: 760px) {
    .vcard { padding: 16px 15px; }
    .vtable { display: block; overflow-x: auto; white-space: nowrap; }
    .vtable td:last-child { white-space: normal; min-width: 190px; }
    .chg-cell { white-space: normal; }
  }
</style>

<script>
  // 投稿指南：按领域筛选（纯客户端，与主题/语言系统解耦；模式同 CS4Q 导读）
  const vFilter = document.getElementById('venues-filter');
  if (vFilter) {
    const chips = Array.from(vFilter.querySelectorAll<HTMLButtonElement>('.chip'));
    const fields = Array.from(document.querySelectorAll<HTMLElement>('.vfield'));
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const f = chip.dataset.f || 'all';
      chips.forEach((c) => c.classList.toggle('on', c === chip));
      fields.forEach((s) => s.classList.toggle('hidden-by-filter', f !== 'all' && s.dataset.field !== f));
    }));
  }
</script>
