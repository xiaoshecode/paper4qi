---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperBrowser from '../../components/PaperBrowser.astro';
---

<BaseLayout title="QCE 会议论文浏览器">
  <main class="wrap">
    <section class="page-head">
      <div class="kicker">IEEE Quantum Week · 2020–2026</div>
      <h1>QCE 会议论文浏览器</h1>
      <p class="lede">
        IEEE QCE（International Conference on Quantum Computing and Engineering）2020–2026 年文献汇总：
        2020–2025 年论文集 <b>1674</b> 条，2026 年官方日程 <b>372</b> 篇（日程条目带 Track / Session / 具体时间），
        其中 <b>214</b> 篇已匹配到 arXiv 预印本。支持多关键词检索、年份与 13 个研究方向叠加筛选、命中高亮与 CSV 导出。
      </p>
    </section>
    <section class="page-body">
      <PaperBrowser source="qce" />
    </section>
  </main>
</BaseLayout>
