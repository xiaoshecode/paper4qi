---
// 三态主题切换：auto（跟随系统）→ light → dark
---
<button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换主题" title="主题：跟随系统">
  <svg class="ic-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
  <svg class="ic-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ic-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
</button>
<script>
  const KEY = 'p4q-theme';
  const btn = document.getElementById('theme-toggle')!;
  const icons = {
    auto: btn.querySelector<SVGElement>('.ic-auto')!,
    light: btn.querySelector<SVGElement>('.ic-light')!,
    dark: btn.querySelector<SVGElement>('.ic-dark')!,
  };
  const titles = { auto: '主题：跟随系统', light: '主题：浅色', dark: '主题：深色' } as const;
  type Mode = keyof typeof titles;
  const getMode = (): Mode => {
    try { return (localStorage.getItem(KEY) as Mode) || 'auto'; } catch { return 'auto'; }
  };
  const apply = (mode: Mode) => {
    const dark = mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    (Object.keys(icons) as Mode[]).forEach((k) => { icons[k].style.display = k === mode ? '' : 'none'; });
    btn.title = titles[mode];
  };
  btn.addEventListener('click', () => {
    const next: Mode = getMode() === 'auto' ? 'light' : getMode() === 'light' ? 'dark' : 'auto';
    try { localStorage.setItem(KEY, next); } catch {}
    apply(next);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if (getMode() === 'auto') apply('auto'); });
  apply(getMode());
</script>
