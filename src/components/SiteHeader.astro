---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { SITE } from '../data/meta';
interface Props { active: string; }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { path: '', zh: '总览', en: 'Overview' },
  { path: 'research/', zh: '研究地图', en: 'Research map' },
  { path: 'qce/', zh: 'QCE 会议', en: 'QCE papers' },
  { path: 'tqe/', zh: 'TQE 期刊', en: 'TQE papers' },
  { path: 'cs4q/', zh: 'CS4Q 导读', en: 'CS4Q guide' },
  { path: 'openqasm/', zh: 'OpenQASM', en: 'OpenQASM' },
  { path: 'venues/', zh: '期刊会议', en: 'Venues' },
  { path: 'stats/', zh: '方向统计', en: 'Statistics' },
  { path: 'agents/', zh: 'Agent 数据', en: 'Agent data' },
  { path: 'about/', zh: '数据说明', en: 'About data' },
];
const isActive = (path: string) => path ? active.startsWith(`${base}${path}`) : active.replace(/\/$/, '') === base.replace(/\/$/, '');
---
<header class="site-header">
  <div class="wrap header-top">
    <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">q<span>i</span></span><span>{SITE.short}<span class="sub">{SITE.name}</span></span></a>
    <div class="header-tools"><a class="header-repo" href="https://github.com/xiaoshecode/paper4qi" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a><LangToggle /><ThemeToggle /></div>
  </div>
  <div class="wrap header-nav-wrap"><nav class="site-nav" aria-label="主导航 / Main navigation">{links.map((l) => <a href={`${base}${l.path}`} class={isActive(l.path) ? 'active' : ''} aria-current={isActive(l.path) ? 'page' : undefined}><span class="i18n-zh">{l.zh}</span><span class="i18n-en">{l.en}</span></a>)}</nav></div>
</header>
<script>
  // Keep the current destination visible in the horizontally scrollable mobile navigation.
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
  if (nav && current && nav.scrollWidth > nav.clientWidth) {
    nav.scrollLeft = Math.max(0, current.offsetLeft - nav.offsetLeft - (nav.clientWidth - current.clientWidth) / 2);
  }
</script>
