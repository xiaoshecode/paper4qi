---
import ThemeToggle from './ThemeToggle.astro';
interface Props { active: string; }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}`, label: '总览', match: (p: string) => p === base || p === base.replace(/\/$/, '') + '/' },
  { href: `${base}qce/`, label: 'QCE 会议', match: (p: string) => p.startsWith(`${base}qce/`) },
  { href: `${base}tqe/`, label: 'TQE 期刊', match: (p: string) => p.startsWith(`${base}tqe/`) },
  { href: `${base}stats/`, label: '方向统计', match: (p: string) => p.startsWith(`${base}stats/`) },
  { href: `${base}about/`, label: '数据说明', match: (p: string) => p.startsWith(`${base}about/`) },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={base}>
      paper4qi<span class="sub">量子计算文献库</span>
    </a>
    <nav class="site-nav">
      {links.map((l) => (
        <a href={l.href} class={l.match(active) ? 'active' : ''} aria-current={l.match(active) ? 'page' : undefined}>{l.label}</a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>
