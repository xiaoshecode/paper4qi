---
// 双源增长折线图（纯 SVG）
// 说明：轴刻度为年份/数字，series 名为 QCE/TQE，均无需翻译；唯一的中文是 SVG aria-label
// （属性是单行文本，无法用 display:none 分流），故按 StackedBars <title> 的同一折衷中英拼接
interface Props {
  series: { name: string; color: string; points: [number, number][] }[]; // (year, count)
}
const { series } = Astro.props;
const years = [...new Set(series.flatMap((s) => s.points.map(([y]) => y)))].sort((a, b) => a - b);
const maxV = Math.max(...series.flatMap((s) => s.points.map(([, n]) => n)), 1);
const W = 920, H = 260, padL = 44, padB = 26, padT = 12, padR = 14;
const plotW = W - padL - padR, plotH = H - padT - padB;
const niceMax = Math.ceil(maxV / 100) * 100;
const x2px = (y: number) => padL + ((y - years[0]) / Math.max(years[years.length - 1] - years[0], 1)) * plotW;
const y2px = (v: number) => padT + plotH - (v / niceMax) * plotH;
const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(niceMax * f));
---
<svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label="两源逐年论文数折线图 / Papers per Year by Source">
  {ticks.map((v) => {
    const py = y2px(v);
    return (
      <g>
        <line x1={padL} y1={py} x2={W - padR} y2={py} stroke="var(--line)" />
        <text x={padL - 6} y={py + 3.5} text-anchor="end" font-size="10" fill="var(--faint)">{v}</text>
      </g>
    );
  })}
  {years.map((y) => (
    <text x={x2px(y)} y={H - 8} text-anchor="middle" font-size="11" fill="var(--faint)">{y}</text>
  ))}
  {series.map((s) => {
    const pts = s.points.map(([y, n]) => `${x2px(y)},${y2px(n)}`).join(' ');
    return (
      <g>
        <polyline points={pts} fill="none" stroke={s.color} stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
        {s.points.map(([y, n]) => (
          <g>
            <circle cx={x2px(y)} cy={y2px(n)} r="3" fill={s.color} />
            <text x={x2px(y)} y={y2px(n) - 7} text-anchor="middle" font-size="10" font-weight="650" fill="var(--muted)">{n}</text>
            <title>{`${s.name} ${y}: ${n}`}</title>
          </g>
        ))}
      </g>
    );
  })}
</svg>
