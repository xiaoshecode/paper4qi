---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE } from '../data/meta';

interface Props {
  title: string;
  description?: string;
}
const { title, description = `${SITE.tagline}。检索 IEEE QCE 与 TQE 文献及会议日程记录，按年份与研究方向筛选，阅读专题导读，获取可追溯的结构化研究数据。` } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN" data-lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={description}>
<title>{title} · {SITE.short} · {SITE.name}</title>
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="alternate" type="application/json" title="paper4qi data manifest" href={`${base}data/manifest.json`}>
<script is:inline>
  (() => {
    const KEY = 'p4q-theme';
    let s = 'auto';
    try { s = localStorage.getItem(KEY) || 'auto'; } catch (e) {}
    const dark = s === 'dark' || (s === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    const LANG_KEY = 'p4q-lang';
    let lang = 'zh';
    try { if (localStorage.getItem(LANG_KEY) === 'en') lang = 'en'; } catch (e) {}
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
  })();
</script>
</head>
<body>
<a class="skip-link" href="#main-content"><span class="i18n-zh">跳至主要内容</span><span class="i18n-en">Skip to content</span></a>
<SiteHeader active={Astro.url.pathname} />
<div id="main-content" tabindex="-1"><slot /></div>
<footer class="site-footer"><div class="wrap">
  <div class="footer-brand">{SITE.short}<span><span class="i18n-zh">量子基础设施文献库</span><span class="i18n-en">Quantum infrastructure research library</span></span></div>
  <div class="footer-links"><a href={`${base}about/`}><span class="i18n-zh">数据与来源</span><span class="i18n-en">Data & sources</span></a><a href={`${base}agents/`}><span class="i18n-zh">Agent 接入</span><span class="i18n-en">Agent access</span></a><a href="https://github.com/xiaoshecode/paper4qi" target="_blank" rel="noopener">GitHub ↗</a></div>
  <p><span class="i18n-zh">IEEE Xplore / Crossref · OpenAlex · arXiv · QCE26 日程。文献数据计划每周更新；人工策展内容以各页标注日期为准。</span><span class="i18n-en">IEEE Xplore / Crossref · OpenAlex · arXiv · QCE26 program. Literature updates are scheduled weekly; curated guides carry their own review dates.</span></p>
</div></footer>
</body>
</html>
