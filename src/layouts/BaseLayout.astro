---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'IEEE QCE 与 IEEE TQE 量子计算文献库：可搜索、按年份与研究方向分类、附中文创新点说明。' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={description}>
<title>{title} · paper4qi 量子计算文献库</title>
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<script is:inline>
  (() => {
    const KEY = 'p4q-theme';
    let s = 'auto';
    try { s = localStorage.getItem(KEY) || 'auto'; } catch (e) {}
    const dark = s === 'dark' || (s === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
  })();
</script>
</head>
<body>
<SiteHeader active={Astro.url.pathname} />
<slot />
<footer class="site-footer"><div class="wrap">
  数据：IEEE Xplore / Crossref · OpenAlex · arXiv · QCE26 官方日程 ｜ 每周自动更新 · <a href="https://github.com/xiaoshecode/paper4qi" target="_blank" rel="noopener">GitHub</a>
</div></footer>
</body>
</html>
